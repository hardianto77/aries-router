[Unit]
Description=ProxyVault proxy harvester
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/proxyvault
ExecStart=/home/ubuntu/venvs/proxyvault/bin/python run.py
Environment=PV_PORT=8022
Environment=PV_ADMIN_USER=admin
Environment=PV_ADMIN_PASS=[REDACTED]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
